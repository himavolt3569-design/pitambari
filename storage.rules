rules_version = '2';

// =============================================================================
// Super Shine - Cloud Storage security rules
//
// Nothing in this application uses Cloud Storage any more.
//
// Images - product shots, QR codes, payment screenshots - are stored as base64
// chunks in Firestore and served by /api/media, which checks on every request
// whether the caller is allowed to see that particular image. The only code
// still touching a bucket is signedProofUrl in src/lib/data/admin.ts, which
// mints a short-lived signed URL for a payment screenshot belonging to an order
// taken before that move. It runs on the Admin SDK, which bypasses these rules
// entirely, so staff keep their access to those older files no matter what is
// written here.
//
// So every path is closed. This is not caution for its own sake: the previous
// version allowed `create` under payment-proofs/{orderId}/ to anyone at all,
// with no authentication and no check that the order existed. Anybody on the
// internet could write images into the bucket, and pay for the privilege on our
// behalf.
//
// If Storage is ever wanted again, open one specific path deliberately, and
// require both authentication and a server-issued token proving the upload
// belongs to a real order. Do not restore the rules that were here before.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
