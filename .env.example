
NEXT_PUBLIC_SITE_URL=https://supershine.com.np

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Reverse geocoding for the checkout address autofill. Defaults to the public
# Nominatim instance, which is fine for development but is not licensed for
# commercial traffic at volume — point this at a paid geocoder in production.
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse

# Payment gateways. Nothing reads these yet; the checkout takes bank transfer
# and wallet screenshots that an admin confirms by hand.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
